#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DVORAK 0
#define LOWER 1
#define RAISE 2
#define NAV 3
#define QWERTY 4
#define CONFIG 5

/*
 * Approximate the QMK home-row mods configured with:
 *
 *   CHORDAL_HOLD
 *   TAPPING_TERM 175 (raised to 280 ms in ZMK to protect same-hand rolls)
 *   QUICK_TAP_TERM 0
 *
 * Opposite-hand chords trigger the modifier hold. Same-hand rolls are biased
 * toward letters unless the home-row key is held past the tapping term.
 */
/ {
        behaviors {
                lhm: left_home_row_mod {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "balanced";
                        tapping-term-ms = <250>;
                        quick-tap-ms = <0>;
                        require-prior-idle-ms = <125>;
                        bindings = <&kp>, <&kp>;
                        hold-trigger-key-positions = <
                                6 7 8 9 10 11
                                18 19 20 21 22 23
                                30 31 32 33 34 35
                                39 40 41
                        >;
                        hold-trigger-on-release;
                };

                rhm: right_home_row_mod {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "balanced";
                        tapping-term-ms = <250>;
                        quick-tap-ms = <0>;
                        require-prior-idle-ms = <125>;
                        bindings = <&kp>, <&kp>;
                        hold-trigger-key-positions = <
                                0 1 2 3 4 5
                                12 13 14 15 16 17
                                24 25 26 27 28 29
                                36 37 38
                        >;
                        hold-trigger-on-release;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "Dvorak";
// -----------------------------------------------------------------------------------------
// |  TAB |  '  |  ,  |  .  |  P  |  Y  |   |  F  |  G  |  C  |  R  |  L  | BSPC |
// | ESC  | A/CT| O/AL| E/GU| U/SH|  I  |   |  D  | H/SH| T/GU| N/AL| S/CT|  -   |
// | CAPS |  ;  |  Q  |  J  |  K  |  X  |   |  B  |  M  |  W  |  V  |  Z  | DEL  |
//                    | NAV | LWR | SPC |   | ENT | RSE | NAV |
                        bindings = <
   &kp TAB       &kp SQT        &kp COMMA      &kp DOT        &kp P          &kp Y          &kp F          &kp G          &kp C          &kp R          &kp L          &kp BSPC
   &kp ESC       &lhm LCTRL A   &lhm LALT O    &lhm LGUI E    &lhm LSHFT U   &kp I          &kp D          &rhm RSHFT H   &rhm RGUI T    &rhm LALT N    &rhm RCTRL S   &kp MINUS
   &caps_word    &kp SEMI       &kp Q          &kp J          &kp K          &kp X          &kp B          &kp M          &kp W          &kp V          &kp Z          &kp DEL
                                                    &mo NAV       &mo LOWER     &kp SPACE      &kp RET        &mo RAISE     &mo NAV
                        >;
                };

                lower_layer {
                        display-name = "Numbers";
// -----------------------------------------------------------------------------------------
// |      |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |      |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   |  *  |  4  |  5  |  6  |  +  |  =   |
// |      |     |     |     |     |     |   |  /  |  1  |  2  |  3  |  -  |      |
//                    |     |     |     |   |     |  .  |  0  |
                        bindings = <
   &trans        &kp N1         &kp N2         &kp N3         &kp N4         &kp N5         &kp N6         &kp N7         &kp N8         &kp N9         &kp N0         &trans
   &bt BT_CLR    &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4   &kp KP_MULTIPLY &kp N4        &kp N5        &kp N6        &kp KP_PLUS    &kp EQUAL
   &trans        &trans          &trans          &trans          &trans          &trans          &kp KP_DIVIDE   &kp N1        &kp N2        &kp N3        &kp KP_MINUS   &trans
                                                    &trans        &trans          &trans          &trans          &kp DOT        &kp N0
                        >;
                };

                raise_layer {
                        display-name = "Symbols";
// -----------------------------------------------------------------------------------------
// |  `  |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  |      |
// |     |  ~  |  |  |  /  |  (  |  {  |   |  }  |  )  |  \  |  -  |  =  |  -   |
// |     | XXX | XXX | XXX |  [  | XXX |   | XXX |  ]  |  ?  |  _  |  +  |      |
//                    |     |     |     |   |     |     |     |
                        bindings = <
   &kp GRAVE     &kp EXCL        &kp AT          &kp HASH        &kp DLLR        &kp PRCNT       &kp CARET       &kp AMPS        &kp ASTRK       &kp LPAR        &kp RPAR        &trans
   &trans        &kp TILDE       &kp PIPE        &kp FSLH        &kp LPAR        &kp LBRC        &kp RBRC        &kp RPAR        &kp BSLH        &kp MINUS       &kp EQUAL       &kp MINUS
   &trans        &none           &none           &none           &kp LBKT        &none           &none           &kp RBKT        &kp QUESTION    &kp UNDER       &kp PLUS        &trans
                                                    &trans        &trans          &trans          &trans          &trans          &trans
                        >;
                };

                nav_layer {
                        display-name = "Functions";
// -----------------------------------------------------------------------------------------
// | QWERTY| F1 | F2 | F3 | F4 | F5 |   |     | PGUP |     |     | RIGHT |     |
// |       | F6 | F7 | F8 | F9 |F10 |   |     | LEFT |     |     |       |     |
// |       |F11 |F12 | DWN| UP |    |   |     | PGDN |     |     |       |     |
//                    |    |    |    |   |     |      | ALT |
                        bindings = <
   &tog QWERTY   &kp F1          &kp F2          &kp F3          &kp F4          &kp F5          &trans          &kp PG_UP       &trans          &trans          &kp RIGHT       &trans
   &trans        &kp F6          &kp F7          &kp F8          &kp F9          &kp F10         &trans          &kp LEFT        &trans          &trans          &trans          &trans
   &trans        &kp F11         &kp F12         &kp DOWN        &kp UP          &trans          &trans          &kp PG_DN       &trans          &trans          &trans          &trans
                                                    &trans        &trans          &trans          &trans          &trans          &kp LALT
                        >;
                };

                qwerty_layer {
                        display-name = "QWERTY";
// -----------------------------------------------------------------------------------------
// | TAB | Q | W | E | R | T |   | Y | U | I | O | P |      |
// | ESC | A | S | D | F | G |   | H | J | K | L | ; | DVOR |
// | SHFT| Z | X | C | V | B |   | N | M | , | . | / | CONF |
//                  | ALT | CTRL | SPC |   | ENT | F1 | ALT |
                        bindings = <
   &kp TAB       &kp Q           &kp W           &kp E           &kp R           &kp T           &kp Y           &kp U           &kp I           &kp O           &kp P           &trans
   &kp ESC       &kp A           &kp S           &kp D           &kp F           &kp G           &kp H           &kp J           &kp K           &kp L           &kp SEMI        &tog QWERTY
   &kp LSHFT     &kp Z           &kp X           &kp C           &kp V           &kp B           &kp N           &kp M           &kp COMMA       &kp DOT         &kp FSLH        &tog CONFIG
                                                    &kp LALT      &kp LCTRL       &kp SPACE       &kp RET         &kp F1          &kp LALT
                        >;
                };

                config_layer {
                        display-name = "BLE Settings";
// -----------------------------------------------------------------------------------------
// | BOOT |     |     |     |     |     |   | USB | BLE | BTPRV | BTNEXT |     |     |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   |     |     |       |        |     |     |
// |CLRALL|     |     |     |     |     |   |     |     |       |        |     | EXIT|
//                    |     |     |     |   |     |      |     |
                        bindings = <
   &bootloader   &none           &none           &none           &none           &none           &out OUT_USB    &out OUT_BLE    &bt BT_PRV      &bt BT_NXT      &none           &none
   &bt BT_CLR    &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &none           &none           &none           &none           &none           &none
   &bt BT_CLR_ALL &none          &none           &none           &none           &none           &none           &none           &none           &none           &none           &tog CONFIG
                                                    &trans        &trans          &trans          &trans          &trans          &trans
                        >;
                };
        };
};
